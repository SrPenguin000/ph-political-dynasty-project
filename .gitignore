# Environment & Secrets
.env
*.pem
*.key
secrets/

# Ignore ALL files and subfolders inside data
data/*
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/staging/
data/staging/*
!data/staging/.gitkeep
!data/curated/
data/curated/*
!data/curated/.gitkeep

# Safety Net: Block large data files anywhere in the repository
*.parquet
*.csv
*.tsv
*.jsonl
*.zip
*.tar.gz
*.7z
*.db
*.sqlite
*.sqlite3

# Airflow & Pipeline Logs
logs/*
!logs/.gitkeep
airflow.db
airflow.cfg
webserver_config.py

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Notebook Checkpoints & OS Clutter
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/